// High-resolution shadow buffer for fm.exe 7.0.2. See hires.h and README "Hi-res rendering".
//
// Surfaces (IMAGE_BASE) in fm.exe: vtable +0x14 width, +0x18 height, +0x2c pixel_ptr(pt,&pitch),
// +0x30 lock_rect(rect,&pitch) -> uint32*, +0x34 unlock(); clip rect (local coords) at +0x08,
// origin at +0x10. All drawing writes raw pixels between lock_rect and unlock.
//
// We patch lock_rect/unlock in the SI_WINDOW_PLATFORM vtable: every locked rect is upscaled from
// the logical buffer into the shadow buffer at unlock ("fallback"). Text drawing
// (FONT draw_string) is instead replayed onto a proxy surface backed by the shadow buffer with
// the T2K transform scaled, and its fallback is suppressed - so text is rasterised natively.

#include "hires.h"
#include "hook.h"
#include <math.h>
#include <stdlib.h>
#include <intrin.h>
#include <string.h>

// ---- fm.exe 7.0.2 addresses -----------------------------------------------------------------

#define VT_WINDOW_PLATFORM      0x013F1E4C // SI_WINDOW_PLATFORM::vftable (.rdata)
#define VT_IMAGE                0x013D7834 // IMAGE::vftable (off-screen pixel buffer)
#define VT_SLOT_LOCK_RECT       0x30
#define VT_SLOT_UNLOCK          0x34
#define ADDR_WIN_LOCK_RECT      0x00E01450 // SI_WINDOW::lock_rect(rect, &pitch)
#define ADDR_SHARED_RET         0x00E50ED0 // folded "ret" used for unlock

#define ADDR_DRAW_STRING        0x00EE1E90 // FONT::draw_string(surf,x,y,&col,&outline,str,hit_cb)
#define ADDR_SET_FONT_SIZE      0x00EE1270 // FONT::select(style{.,flags}, size_x, size_y)
#define ADDR_MEASURE_STRING     0x00EE2530 // FONT::measure(str, all_advances) -> px, thiscall ret 8
#define ADDR_T2K_SET_TRANSFORM  0x00F05090 // cdecl (scaler, 0, xdpi, ydpi, int matrix[4], 1, &err)
#define ADDR_FILL_RECT          0x00DFDB50 // IMAGE_BASE::fill_rect(rect, colour, alpha)
#define ADDR_BLIT_ALPHA         0x00DFCB00 // IMAGE_BASE::blit_alpha(x, y, src, alpha)
#define ADDR_BLIT_COPY          0x00DFCC30 // IMAGE_BASE::blit_copy(x, y, src)
#define ADDR_DRAW_LINE          0x00DFB850 // IMAGE_BASE::draw_line(&p0, &p1, colour, ...), ret 0x18
#define ADDR_TILE_IMAGE         0x00DFFD80 // IMAGE_BASE::tile(&rect, src, mode 0 copy/1 alpha), ret 0xc
#define ADDR_SNAPSHOT           0x00DFB740 // IMAGE::copy_from(src_surface, &rect): resize + copy, ret 8

static const BYTE SIG_DRAW_STRING[] = { 0x83, 0xEC, 0x68, 0x55, 0x8B, 0x29, 0x8A, 0x45, 0x00 };
static const BYTE SIG_MEASURE_STRING[] = { 0x83, 0xEC, 0x08, 0x8B, 0x01, 0x80, 0x38, 0x00, 0x89, 0x0C, 0x24 };
static const BYTE SIG_SET_FONT_SIZE[] = { 0x83, 0xEC, 0x38, 0x56, 0x8B, 0x31, 0x8A, 0x06 };
static const BYTE SIG_T2K_SET_TRANSFORM[] = { 0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x48, 0x8B, 0x45, 0x20 };
static const BYTE SIG_FILL_RECT[] = { 0x83, 0xEC, 0x20, 0x8B, 0x44, 0x24, 0x24, 0x66, 0x8B, 0x50, 0x02 };
static const BYTE SIG_BLIT_ALPHA[] = { 0x83, 0xEC, 0x1C, 0x55, 0x56, 0x8B, 0x74, 0x24, 0x30 };
static const BYTE SIG_BLIT_COPY[] = { 0x83, 0xEC, 0x1C, 0x53, 0x56, 0x8B, 0x74, 0x24, 0x30 };
static const BYTE SIG_DRAW_LINE[] = { 0x83, 0xEC, 0x28, 0x8B, 0x44, 0x24, 0x2C, 0x8B, 0x54, 0x24, 0x30, 0x53 };
static const BYTE SIG_TILE_IMAGE[] = { 0x83, 0xEC, 0x38, 0x53, 0x8B, 0x5C, 0x24, 0x44, 0x8B, 0x03, 0x55, 0x56 };
static const BYTE SIG_SNAPSHOT[] = { 0x8B, 0x44, 0x24, 0x08, 0x83, 0xEC, 0x0C, 0x53, 0x55, 0x8B, 0x6C, 0x24, 0x18 };

// SI_WINDOW_PLATFORM back buffer fields
#define WIN_BITS     0x7C
#define WIN_BB_W     0x80
#define WIN_BB_H     0x82
#define WIN_PITCH    0x88 // short, in pixels
#define WIN_DIRTY_X0 0x8E
#define WIN_DIRTY_X1 0x90
#define WIN_DIRTY_Y0 0x92
#define WIN_DIRTY_Y1 0x94
// IMAGE_BASE fields
#define SURF_CLIP    0x08 // short x, y, w, h (local coordinates)
#define SURF_ORIGIN  0x10 // short x, y

// FONT object (*font_handle)
#define FONT_LOADED  0x00
#define FONT_FLAGS   0x1C // style flags; part of the glyph cache key
#define FONT_SIZE_X  0x20
#define FONT_SIZE_Y  0x21
#define FONT_GLYPHS  0x28 // GLYPH** sorted cache
#define FONT_NGLYPHS 0x2C
// GLYPH (cache entry), DWORD indices
#define GLYPH_ADVANCE_X 6 // 16.16 pen advance
#define GLYPH_CHAR      8
#define GLYPH_KEY       9 // flags<<16 | size_y<<8 | size_x

// Style flag bits unused by the renderer; set during the hi-res pass so its glyphs get their
// own cache entries (key = flags<<16 | size_y<<8 | size_x). Bits 10..14 = zoom generation.
#define HIRES_TAG    0x8000

typedef DWORD *(__fastcall *lock_rect_t)(BYTE *self, void *edx, short *rect, short *pitch);
typedef void(__fastcall *draw_string_t)(void **font, void *edx, BYTE *surf, int x, int y,
	DWORD *colour, DWORD *outline, void *str, void *hit_cb);
typedef void(__fastcall *fill_rect_t)(BYTE *surf, void *edx, short *rect, DWORD colour, int alpha);
typedef void(__fastcall *blit_alpha_t)(BYTE *dst, void *edx, int x, int y, BYTE *src, int alpha);
typedef void(__fastcall *blit_copy_t)(BYTE *dst, void *edx, int x, int y, BYTE *src);
typedef void(__fastcall *snapshot_t)(BYTE *img, void *edx, BYTE *src, short *rect);
typedef void(__fastcall *tile_image_t)(BYTE *dst, void *edx, short *rect, BYTE *src, int mode);
typedef void(__fastcall *draw_line_t)(BYTE *surf, void *edx, short *p0, short *p1, int a3, int a4,
	int a5, int a6);
typedef short(__fastcall *vf_short_t)(void *self, void *edx);
typedef char(__fastcall *vf_char_t)(void *self, void *edx);
typedef void(__fastcall *vf_get_colour_t)(void *self, void *edx, DWORD *colour);
typedef DWORD *(__fastcall *vf_pixel_ptr_t)(void *self, void *edx, short *pt, short *pitch);
typedef short(__fastcall *measure_string_t)(void **font, void *edx, void *str, int all_advances);
typedef void(__fastcall *set_font_size_t)(void **font, void *edx, void *style, int sx, int sy);
typedef int(__cdecl *t2k_set_transform_t)(void *scaler, int a, int xdpi, int ydpi, int *matrix,
	int b, void *err);

static void (*logf_)(const char *fmt, ...);
static BOOL g_smooth;
static BOOL g_installed;

static draw_string_t orig_draw_string;
static measure_string_t orig_measure_string;
static t2k_set_transform_t orig_t2k_set_transform;
static fill_rect_t orig_fill_rect;
static blit_alpha_t orig_blit_alpha;
static blit_copy_t orig_blit_copy;
static draw_line_t orig_draw_line;
static tile_image_t orig_tile_image;
static snapshot_t orig_snapshot;
static const lock_rect_t win_lock_rect = (lock_rect_t)ADDR_WIN_LOCK_RECT;
static const set_font_size_t set_font_size = (set_font_size_t)ADDR_SET_FONT_SIZE;
static const measure_string_t measure_string = (measure_string_t)ADDR_MEASURE_STRING;

// ---- shadow buffer state --------------------------------------------------------------------

static BYTE *g_win;
static int g_pw, g_ph, g_lw, g_lh;
static double g_zx = 1.0, g_zy = 1.0;
static HDC g_hdc;
static HBITMAP g_bmp;
static DWORD *g_bits;
static BOOL g_on;

static int g_suppress;      // >0: window unlocks do not upscale (op is replayed natively)
static int g_text_depth;    // draw_string recursion (shadow/outline styles call themselves)
static double g_tscale = 1.0; // applied to the next T2K transform
static int g_hx0, g_hy0;    // position of the current hi-res draw_string (shadow offsets)
static DWORD g_tag = HIRES_TAG;
static int g_gen;

#define MAX_PENDING 64
static short g_pending[MAX_PENDING][4];
static int g_npending;

static int sx_(int v) { return (int)floor(v * g_zx + 0.5); }
static int sy_(int v) { return (int)floor(v * g_zy + 0.5); }

BOOL hires_active(void) { return g_on; }

static void upscale(int x, int y, int w, int h);

void hires_on_back_buffer(BYTE *win, int pw, int ph, int lw, int lh)
{
	BITMAPINFO bi;
	double old_zx = g_zx;

	// Same geometry: the game kept its buffer (and will not redraw), so keep ours too.
	if (g_bmp && win == g_win && pw == g_pw && ph == g_ph && lw == g_lw && lh == g_lh) {
		g_on = TRUE;
		return;
	}
	g_on = FALSE;
	if (g_bmp) {
		DeleteObject(g_bmp);
		g_bmp = NULL;
		g_bits = NULL;
	}
	if (!g_hdc)
		g_hdc = CreateCompatibleDC(NULL);
	g_win = win;
	g_npending = 0;
	if (!g_installed || (pw == lw && ph == lh) || lw <= 0 || lh <= 0)
		return;

	memset(&bi, 0, sizeof bi);
	bi.bmiHeader.biSize = sizeof bi.bmiHeader;
	bi.bmiHeader.biWidth = pw;
	bi.bmiHeader.biHeight = -ph; // top-down
	bi.bmiHeader.biPlanes = 1;
	bi.bmiHeader.biBitCount = 32;
	g_bmp = CreateDIBSection(g_hdc, &bi, DIB_RGB_COLORS, (void **)&g_bits, NULL, 0);
	if (!g_bmp) {
		logf_("hires: CreateDIBSection %dx%d failed", pw, ph);
		return;
	}
	SelectObject(g_hdc, g_bmp);
	g_pw = pw;
	g_ph = ph;
	g_lw = lw;
	g_lh = lh;
	g_zx = (double)pw / lw;
	g_zy = (double)ph / lh;
	if (g_zx != old_zx) {
		g_gen = (g_gen + 1) & 0x1F;
		g_tag = HIRES_TAG | (DWORD)g_gen << 10;
	}
	g_on = TRUE;
	upscale(0, 0, lw, lh); // never start blank
	logf_("hires: shadow %dx%d for logical %dx%d", pw, ph, lw, lh);
}

// ---- fallback: upscale a logical rect into the shadow buffer ---------------------------------

// ---- parallel rows --------------------------------------------------------------------------------
// Our own scaling work (it only reads finished game pixels and writes our shadow buffer or cache) is
// split by rows across a small worker pool while the calling (game main) thread waits. No game code
// or game data is touched from the workers.

#define MAX_WORKERS 8
#define PARALLEL_MIN_PIXELS 32768 // smaller jobs run inline

typedef void (*rows_fn)(void *ctx, int y0, int y1);
static struct {
	rows_fn fn;
	void *ctx;
	int bounds[MAX_WORKERS + 2];
} g_job;
static HANDLE g_start[MAX_WORKERS + 1], g_done;
static volatile LONG g_pool_pending;
static int g_workers = -1; // -1 = not started

static DWORD WINAPI worker(LPVOID arg)
{
	int i = (int)(INT_PTR)arg;
	for (;;) {
		WaitForSingleObject(g_start[i], INFINITE);
		g_job.fn(g_job.ctx, g_job.bounds[i], g_job.bounds[i + 1]);
		if (InterlockedDecrement(&g_pool_pending) == 0)
			SetEvent(g_done);
	}
}

static void pool_start(void)
{
	SYSTEM_INFO si;
	int i, n;
	GetSystemInfo(&si);
	n = (int)si.dwNumberOfProcessors - 1;
	if (n > MAX_WORKERS)
		n = MAX_WORKERS;
	g_workers = 0;
	if (n <= 0)
		return;
	g_done = CreateEventW(NULL, FALSE, FALSE, NULL);
	for (i = 1; i <= n; i++) {
		g_start[i] = CreateEventW(NULL, FALSE, FALSE, NULL);
		CloseHandle(CreateThread(NULL, 0, worker, (LPVOID)(INT_PTR)i, 0, NULL));
	}
	g_workers = n;
	logf_("hires: %d scaling worker threads", n);
}

// Run fn over rows [y0, y1) split into chunks; returns when all are done. Main thread only.
static void parallel_rows(int y0, int y1, int width, rows_fn fn, void *ctx)
{
	int rows = y1 - y0, chunks, i;
	if (g_workers < 0)
		pool_start();
	chunks = g_workers + 1;
	if (chunks > rows / 4)
		chunks = rows / 4;
	if (chunks < 2 || (long long)rows * width < PARALLEL_MIN_PIXELS) {
		fn(ctx, y0, y1);
		return;
	}
	g_job.fn = fn;
	g_job.ctx = ctx;
	for (i = 0; i <= chunks; i++)
		g_job.bounds[i] = y0 + (int)((long long)rows * i / chunks);
	g_pool_pending = chunks - 1;
	for (i = 1; i < chunks; i++)
		SetEvent(g_start[i]);
	fn(ctx, g_job.bounds[0], g_job.bounds[1]);
	WaitForSingleObject(g_done, INFINITE);
}

typedef struct {
	const DWORD *src;
	int pitch, lw, lh, x0, x1;
	const int *col_i, *col_w;
} UPSCALE_JOB;

static void upscale_rows(void *ctx, int y0, int y1)
{
	const UPSCALE_JOB *j = (const UPSCALE_JOB *)ctx;
	int py, px;
	for (py = y0; py < y1; py++) {
		double f = (py + 0.5) / g_zy - 0.5;
		int jr = (int)floor(f);
		int wy = (int)((f - jr) * 256.0);
		const DWORD *r0, *r1;
		DWORD *dst = g_bits + (size_t)py * g_pw;
		if (jr < 0) { jr = 0; wy = 0; }
		if (jr >= j->lh - 1) { jr = j->lh - 1; wy = 0; }
		if (!g_smooth)
			wy = wy >= 128 ? 256 : 0;
		r0 = j->src + (size_t)jr * j->pitch;
		r1 = wy ? r0 + j->pitch : r0;
		for (px = j->x0; px < j->x1; px++) {
			int i = j->col_i[px - j->x0], wx = j->col_w[px - j->x0];
			DWORD a = r0[i], b = wx ? r0[i + 1] : a, c = r1[i], d = wx ? r1[i + 1] : c;
			DWORD ix = 256 - wx, iy = 256 - wy;
			// weighted sums two channels at a time (lanes 16 bits apart; max 255*256 fits)
			DWORD rb0 = ((a & 0xFF00FF) * ix + (b & 0xFF00FF) * wx) >> 8 & 0xFF00FF;
			DWORD ga0 = ((a >> 8 & 0xFF00FF) * ix + (b >> 8 & 0xFF00FF) * wx) >> 8 & 0xFF00FF;
			DWORD rb1 = ((c & 0xFF00FF) * ix + (d & 0xFF00FF) * wx) >> 8 & 0xFF00FF;
			DWORD ga1 = ((c >> 8 & 0xFF00FF) * ix + (d >> 8 & 0xFF00FF) * wx) >> 8 & 0xFF00FF;
			DWORD rb = (rb0 * iy + rb1 * wy) >> 8 & 0xFF00FF;
			DWORD ga = (ga0 * iy + ga1 * wy) >> 8 & 0xFF00FF;
			dst[px] = rb | ga << 8;
		}
	}
}

static void upscale(int x, int y, int w, int h)
{
	const DWORD *src = *(DWORD **)(g_win + WIN_BITS);
	int pitch = *(short *)(g_win + WIN_PITCH);
	int lw = *(short *)(g_win + WIN_BB_W), lh = *(short *)(g_win + WIN_BB_H);
	int x0, x1, y0, y1, px;
	static int col_i[8192], col_w[8192];

	if (!src || lw != g_lw || lh != g_lh)
		return;
	if (x < 0) { w += x; x = 0; }
	if (y < 0) { h += y; y = 0; }
	if (x + w > lw) w = lw - x;
	if (y + h > lh) h = lh - y;
	if (w <= 0 || h <= 0)
		return;
	x0 = sx_(x); x1 = sx_(x + w);
	y0 = sy_(y); y1 = sy_(y + h);
	if (x1 > g_pw) x1 = g_pw;
	if (y1 > g_ph) y1 = g_ph;
	if (x1 - x0 > 8192)
		x1 = x0 + 8192;

	// per-column source index and 8-bit weight (pixel centres aligned)
	for (px = x0; px < x1; px++) {
		double f = (px + 0.5) / g_zx - 0.5;
		int i = (int)floor(f);
		int wt = (int)((f - i) * 256.0);
		if (i < 0) { i = 0; wt = 0; }
		if (i >= lw - 1) { i = lw - 1; wt = 0; }
		col_i[px - x0] = i;
		col_w[px - x0] = g_smooth ? wt : (wt >= 128 ? 256 : 0);
	}
	{
		UPSCALE_JOB j;
		j.src = src; j.pitch = pitch; j.lw = lw; j.lh = lh; j.x0 = x0; j.x1 = x1;
		j.col_i = col_i; j.col_w = col_w;
		parallel_rows(y0, y1, x1 - x0, upscale_rows, &j);
	}
}

static void flush_pending(void)
{
	int i;
	for (i = 0; i < g_npending; i++)
		upscale(g_pending[i][0], g_pending[i][1], g_pending[i][2], g_pending[i][3]);
	g_npending = 0;
}

// ---- diagnostics: who still goes through the fallback / draws text off-window --------------------
// Aggregated per caller chain (first 3 return addresses into fm.exe found on the stack) and dumped
// to the log with every capture (hires_dump).

#define DIAG_SLOTS 64
typedef struct {
	DWORD chain[3];
	DWORD vtable; // surface vtable (text) or 0 (fallback)
	DWORD count;
	double area;  // logical pixels
} DIAG;
static DIAG g_diag_fallback[DIAG_SLOTS], g_diag_text[DIAG_SLOTS];

static BOOL is_return_address(DWORD v)
{
	const BYTE *b = (const BYTE *)v;
	if (v < 0x00401007 || v >= 0x0100D000)
		return FALSE;
	return b[-5] == 0xE8 || (b[-6] == 0xFF && (b[-5] & 0x38) == 0x10) ||
		(b[-3] == 0xFF && (b[-2] & 0x38) == 0x10 && (b[-2] & 0xC0) == 0x40) ||
		(b[-2] == 0xFF && (b[-1] & 0x38) == 0x10 && (b[-1] & 0xC0) == 0xC0) ||
		(b[-2] == 0xFF && (b[-1] & 0x38) == 0x10 && (b[-1] & 0xC0) == 0x00);
}

static void caller_chain(const DWORD *sp, DWORD out[3])
{
	int k, n = 0;
	out[0] = out[1] = out[2] = 0;
	for (k = 0; k < 96 && n < 3; k++)
		if (is_return_address(sp[k]))
			out[n++] = sp[k];
}

static void diag_add(DIAG *t, const DWORD chain[3], DWORD vtable, double area)
{
	int i, free_slot = -1;
	for (i = 0; i < DIAG_SLOTS; i++) {
		if (t[i].count && t[i].vtable == vtable && !memcmp(t[i].chain, chain, 12)) {
			t[i].count++;
			t[i].area += area;
			return;
		}
		if (!t[i].count && free_slot < 0)
			free_slot = i;
	}
	if (free_slot >= 0) {
		memcpy(t[free_slot].chain, chain, 12);
		t[free_slot].vtable = vtable;
		t[free_slot].count = 1;
		t[free_slot].area = area;
	}
}

static void diag_dump(const char *title, DIAG *t)
{
	int i, j, best;
	logf_("diag %s (count, logical px, surface vtable, callers):", title);
	for (j = 0; j < 12; j++) {
		best = -1;
		for (i = 0; i < DIAG_SLOTS; i++)
			if (t[i].count && (best < 0 || t[i].area > t[best].area))
				best = i;
		if (best < 0)
			break;
		logf_("  %6lu %10.0f %08lx  %08lx %08lx %08lx", t[best].count, t[best].area, t[best].vtable,
			t[best].chain[0], t[best].chain[1], t[best].chain[2]);
		t[best].count = 0;
	}
	memset(t, 0, sizeof(DIAG) * DIAG_SLOTS);
}

// ---- window vtable patches -------------------------------------------------------------------

static DWORD *__fastcall hk_win_lock_rect(BYTE *self, void *edx, short *rect, short *pitch)
{
	DWORD *p = win_lock_rect(self, edx, rect, pitch);
	if (g_on && self == g_win && !g_suppress) {
		DWORD chain[3];
		caller_chain((const DWORD *)_AddressOfReturnAddress(), chain);
		diag_add(g_diag_fallback, chain, 0, (double)rect[2] * rect[3]);
		if (g_npending == MAX_PENDING)
			flush_pending();
		memcpy(g_pending[g_npending++], rect, 4 * sizeof(short));
	}
	return p;
}

static void __fastcall hk_win_unlock(BYTE *self, void *edx)
{
	(void)edx;
	if (g_on && self == g_win)
		flush_pending();
}

// ---- proxy surface backed by the shadow buffer -----------------------------------------------

static short __fastcall px_width(void *self, void *edx) { (void)self; (void)edx; return (short)g_pw; }
static short __fastcall px_height(void *self, void *edx) { (void)self; (void)edx; return (short)g_ph; }
static DWORD *__fastcall px_lock(void *self, void *edx, short *rect, short *pitch)
{
	(void)self; (void)edx;
	*pitch = (short)g_pw;
	return g_bits + (size_t)rect[1] * g_pw + rect[0];
}
static void __fastcall px_unlock(void *self, void *edx) { (void)self; (void)edx; }
static void __fastcall px_unexpected(void *self, void *edx)
{
	(void)self; (void)edx;
	logf_("hires: unexpected proxy surface vcall");
}

static void *g_proxy_vt[64];
static struct {
	void **vt;
	void **vt2;
	short clip[4];
	short origin[2];
	BYTE pad[0x100];
} g_proxy;

static void proxy_from_window(BYTE *win);

// As proxy_from_window, additionally clipped to extra[x, y, w, h] (window local coordinates).
static void proxy_from_window_clipped(BYTE *win, const short *extra)
{
	short saved[4], *clip = (short *)(win + SURF_CLIP);
	int l, t, r, b;
	memcpy(saved, clip, sizeof saved);
	if (clip[2] == -1) {
		memcpy(clip, extra, sizeof saved);
	}
	else {
		l = clip[0] > extra[0] ? clip[0] : extra[0];
		t = clip[1] > extra[1] ? clip[1] : extra[1];
		r = clip[0] + clip[2] < extra[0] + extra[2] ? clip[0] + clip[2] : extra[0] + extra[2];
		b = clip[1] + clip[3] < extra[1] + extra[3] ? clip[1] + clip[3] : extra[1] + extra[3];
		clip[0] = (short)l;
		clip[1] = (short)t;
		clip[2] = (short)(r > l ? r - l : 0);
		clip[3] = (short)(b > t ? b - t : 0);
	}
	proxy_from_window(win);
	memcpy(clip, saved, sizeof saved);
}

// Map the window's clip/origin (logical, local) to the shadow buffer.
static void proxy_from_window(BYTE *win)
{
	short *clip = (short *)(win + SURF_CLIP);
	short ox = *(short *)(win + SURF_ORIGIN), oy = *(short *)(win + SURF_ORIGIN + 2);
	int sox = sx_(ox), soy = sy_(oy);
	g_proxy.origin[0] = (short)sox;
	g_proxy.origin[1] = (short)soy;
	if (clip[2] == -1) {
		memcpy(g_proxy.clip, clip, sizeof g_proxy.clip);
	}
	else {
		int x0 = sx_(clip[0] + ox) - sox, x1 = sx_(clip[0] + clip[2] + ox) - sox;
		int y0 = sy_(clip[1] + oy) - soy, y1 = sy_(clip[1] + clip[3] + oy) - soy;
		g_proxy.clip[0] = (short)x0;
		g_proxy.clip[1] = (short)y0;
		g_proxy.clip[2] = (short)(x1 - x0);
		g_proxy.clip[3] = (short)(y1 - y0);
	}
}

// ---- text ------------------------------------------------------------------------------------

static int __cdecl hk_t2k_set_transform(void *scaler, int a, int xdpi, int ydpi, int *m, int b,
	void *err)
{
	int saved[4], i, r;
	if (g_tscale == 1.0 || !m)
		return orig_t2k_set_transform(scaler, a, xdpi, ydpi, m, b, err);
	for (i = 0; i < 4; i++) {
		saved[i] = m[i];
		m[i] = (int)floor(m[i] * g_tscale + 0.5);
	}
	r = orig_t2k_set_transform(scaler, a, xdpi, ydpi, m, b, err);
	memcpy(m, saved, sizeof saved);
	return r;
}

// Make every hi-res glyph advance exactly zoom x its logical twin (same key without the hi-res tag
// bits, same character), so natively rasterised text keeps the game's layout - hinting otherwise
// makes it a little wider and line ends get clipped. The logical glyphs of a string are in the
// cache after the logical pass, the hi-res ones after measure_string in the hi-res pass. Matching
// by full key also covers shadow/outline styles, which draw with temporarily altered flags.
#define KEY_TAG_MASK 0xFC000000u // flags bits 10..15 (HIRES_TAG + zoom generation) << 16
static void match_advances(BYTE *f)
{
	enum { SLOTS = 4096 };
	static DWORD skey[SLOTS], sadv[SLOTS];
	static WORD schar[SLOTS], sgen[SLOTS];
	static WORD gen;
	DWORD **g = *(DWORD ***)(f + FONT_GLYPHS);
	DWORD tag_bits = (g_tag << 16) & KEY_TAG_MASK;
	int n = *(int *)(f + FONT_NGLYPHS), i;
	if (!g || n <= 0)
		return;
	if (++gen == 0) {
		memset(sgen, 0, sizeof sgen);
		gen = 1;
	}
	for (i = 0; i < n; i++) {
		DWORD key, h;
		WORD c;
		if (!g[i] || (g[i][GLYPH_KEY] & KEY_TAG_MASK))
			continue;
		key = g[i][GLYPH_KEY];
		c = (WORD)g[i][GLYPH_CHAR];
		for (h = (key * 2654435761u ^ c) % SLOTS; sgen[h] == gen && (skey[h] != key || schar[h] != c);
			 h = (h + 1) % SLOTS)
			;
		skey[h] = key;
		schar[h] = c;
		sadv[h] = g[i][GLYPH_ADVANCE_X];
		sgen[h] = gen;
	}
	for (i = 0; i < n; i++) {
		DWORD key, h;
		WORD c;
		if (!g[i] || (g[i][GLYPH_KEY] & KEY_TAG_MASK) != tag_bits)
			continue;
		key = g[i][GLYPH_KEY] & ~KEY_TAG_MASK;
		c = (WORD)g[i][GLYPH_CHAR];
		for (h = (key * 2654435761u ^ c) % SLOTS; sgen[h] == gen; h = (h + 1) % SLOTS)
			if (skey[h] == key && schar[h] == c) {
				g[i][GLYPH_ADVANCE_X] = (DWORD)(int)floor((int)sadv[h] * g_zx + 0.5);
				break;
			}
	}
}

static DWORD image_sum(BYTE *img, int *w_out, int *h_out, const DWORD **base_out, int *pitch_out);

// Draw text natively into the shadow buffer at window-local logical (x, y), with the font selected at
// (flags, sx, sy) for the duration. extra_clip (window local, may be NULL) narrows the window clip.
// The font's current selection is restored afterwards.
static void hires_text(void **font, DWORD flags, BYTE sx, BYTE sy, BYTE *win, const short *extra_clip,
	int x, int y, DWORD *colour, DWORD *outline, void *str)
{
	BYTE *f = (BYTE *)*font;
	DWORD cur_flags = *(DWORD *)(f + FONT_FLAGS);
	BYTE cur_sx = f[FONT_SIZE_X], cur_sy = f[FONT_SIZE_Y];
	struct { void *vt; DWORD flags; } style;
	short ox = *(short *)(win + SURF_ORIGIN), oy = *(short *)(win + SURF_ORIGIN + 2);

	style.vt = NULL;
	style.flags = flags;
	f[FONT_SIZE_X] = 0; // force the transform to be rebuilt
	g_tscale = (g_zx + g_zy) / 2;
	set_font_size(font, NULL, &style, sx, sy);
	g_tscale = 1.0;
	*(DWORD *)(f + FONT_FLAGS) = flags | g_tag;
	measure_string(font, NULL, str, 1); // loads every hi-res glyph of the string into the cache
	match_advances(f);

	if (extra_clip)
		proxy_from_window_clipped(win, extra_clip);
	else
		proxy_from_window(win);
	g_hx0 = sx_(x + ox) - g_proxy.origin[0];
	g_hy0 = sy_(y + oy) - g_proxy.origin[1];
	orig_draw_string(font, NULL, (BYTE *)&g_proxy, g_hx0, g_hy0, colour, outline, str, NULL);
	match_advances(f); // styled variants (shadow/outline flags) were first created by the draw

	// restore the selection that was current
	style.flags = cur_flags;
	*(DWORD *)(f + FONT_FLAGS) = cur_flags;
	f[FONT_SIZE_X] = 0;
	set_font_size(font, NULL, &style, cur_sx, cur_sy);
}

// ---- text drawn into off-screen images ----------------------------------------------------------
// Labels with effects are rendered into an IMAGE that is then blitted to the window; scaling that
// image makes the text soft. We record the text drawn into an IMAGE together with a copy of the
// image from before its first text. When the image is blitted to the window unchanged since the
// last recorded text (checksum), the text-free copy is scaled and the text drawn natively on top.

#define IMGTEXT_SLOTS 64
#define IMGTEXT_OPS 16
#define IMGTEXT_CHARS 256
typedef struct {
	DWORD pad;
	WORD len, pad2;
	WCHAR *chars;
} FAKE_STR_INNER;
typedef struct {
	BYTE pad[8];
	FAKE_STR_INNER *inner;
} FAKE_STR;
typedef struct {
	void **font;
	DWORD flags, colour, outline;
	BYTE sx, sy;
	short x, y; // image local
	WCHAR chars[IMGTEXT_CHARS + 1];
	WORD len;
} IMGTEXT_OP;
typedef struct {
	BYTE *img;
	const DWORD *base;
	int w, h;
	DWORD sum_after;  // image checksum after the last recorded text
	DWORD *background; // image pixels before the first text (w*h)
	int nops;
	BOOL overflow;
	DWORD last_use;
	IMGTEXT_OP ops[IMGTEXT_OPS];
} IMGTEXT;
static IMGTEXT *g_imgtext[IMGTEXT_SLOTS];
static DWORD g_imgtext_clock;
// diagnostics: recorded texts, and outcome of blits of images that have recorded text
static DWORD g_it_recorded, g_it_used, g_it_no_record, g_it_changed, g_it_overflow, g_it_alpha, g_it_other;

static IMGTEXT *imgtext_find(BYTE *img)
{
	int i;
	for (i = 0; i < IMGTEXT_SLOTS; i++)
		if (g_imgtext[i] && g_imgtext[i]->img == img)
			return g_imgtext[i];
	return NULL;
}

static IMGTEXT *imgtext_new(BYTE *img)
{
	int i, victim = 0;
	for (i = 0; i < IMGTEXT_SLOTS; i++) {
		if (!g_imgtext[i]) {
			victim = i;
			break;
		}
		if (g_imgtext[i]->last_use < g_imgtext[victim]->last_use)
			victim = i;
	}
	if (!g_imgtext[victim])
		g_imgtext[victim] = (IMGTEXT *)calloc(1, sizeof(IMGTEXT));
	if (!g_imgtext[victim])
		return NULL;
	free(g_imgtext[victim]->background);
	memset(g_imgtext[victim], 0, sizeof(IMGTEXT));
	g_imgtext[victim]->img = img;
	return g_imgtext[victim];
}

static void record_image_text(void **font, void *edx, BYTE *img, short x, short y, DWORD *colour,
	DWORD *outline, void *str)
{
	BYTE *f = (BYTE *)*font;
	int w, h, pitch, row, len, inner;
	const DWORD *base;
	DWORD sum = image_sum(img, &w, &h, &base, &pitch);
	IMGTEXT *t = imgtext_find(img);
	IMGTEXT_OP *op;

	if (!t || t->base != base || t->w != w || t->h != h || t->sum_after != sum) {
		// first text on this image content: keep its text-free pixels
		t = imgtext_new(img);
		if (t && base && w > 0 && h > 0 && (t->background = (DWORD *)malloc((size_t)w * h * 4)) != NULL) {
			for (row = 0; row < h; row++)
				memcpy(t->background + (size_t)row * w, base + (size_t)row * pitch, (size_t)w * 4);
			t->base = base;
			t->w = w;
			t->h = h;
		}
	}
	orig_draw_string(font, edx, img, x, y, colour, outline, str, NULL);
	g_it_recorded++;
	if (!t || !t->background)
		return;
	t->last_use = ++g_imgtext_clock;
	inner = str ? *(int *)((BYTE *)str + 8) : 0;
	len = inner ? *(WORD *)(inner + 4) : 0;
	if (t->nops >= IMGTEXT_OPS || len > IMGTEXT_CHARS || !inner) {
		t->overflow = TRUE;
	}
	else {
		op = &t->ops[t->nops++];
		op->font = font;
		op->flags = *(DWORD *)(f + FONT_FLAGS);
		op->sx = f[FONT_SIZE_X];
		op->sy = f[FONT_SIZE_Y];
		op->x = x;
		op->y = y;
		op->colour = colour ? *colour : 0;
		op->outline = outline ? *outline : 0;
		op->len = (WORD)len;
		memcpy(op->chars, *(WCHAR **)(inner + 8), (size_t)len * 2);
		op->chars[len] = 0;
	}
	t->sum_after = image_sum(img, &w, &h, NULL, NULL);
}

// The text-free copy of src if it can stand in for src at blit time (else NULL).
static IMGTEXT *imgtext_for_blit(BYTE *src, DWORD galpha)
{
	int w, h;
	const DWORD *base;
	IMGTEXT *t;
	if (*(DWORD *)src != VT_IMAGE)
		return NULL;
	if (!(t = imgtext_find(src)) || !t->background || !t->nops) {
		g_it_no_record++;
		return NULL;
	}
	if (t->overflow) {
		g_it_overflow++;
		return NULL;
	}
	if (image_sum(src, &w, &h, &base, NULL) != t->sum_after || w != t->w || h != t->h || base != t->base) {
		g_it_changed++;
		return NULL;
	}
	if (galpha != 0xFF) {
		g_it_alpha++;
		return NULL;
	}
	g_it_used++;
	return t;
}

// Draw the recorded text of an image blitted at window-local logical (x, y).
static void imgtext_replay(IMGTEXT *t, BYTE *win, int x, int y)
{
	short clip[4];
	int i;
	clip[0] = (short)x;
	clip[1] = (short)y;
	clip[2] = (short)t->w;
	clip[3] = (short)t->h;
	g_text_depth++;
	for (i = 0; i < t->nops; i++) {
		IMGTEXT_OP *op = &t->ops[i];
		FAKE_STR_INNER inner;
		FAKE_STR fs;
		DWORD colour = op->colour, outline = op->outline;
		BYTE *f = op->font ? (BYTE *)*op->font : NULL;
		if (!f || !f[FONT_LOADED])
			continue;
		memset(&inner, 0, sizeof inner);
		memset(&fs, 0, sizeof fs);
		inner.len = op->len;
		inner.chars = op->chars;
		fs.inner = &inner;
		hires_text(op->font, op->flags, op->sx, op->sy, win, clip, x + op->x, y + op->y, &colour, &outline, &fs);
	}
	g_text_depth--;
	t->last_use = ++g_imgtext_clock;
}

// ---- branding ---------------------------------------------------------------------------------
// The start screen shows "Version 7.0.2"; with the mod it reads "Version 7.0.2 - FM07HD v1.2". The
// string is matched by content in draw_string and measure_string (so the label is sized for it).

#define BRAND_ORIGINAL L"Version 7.0.2"
static WCHAR g_brand_chars[] = L"Version 7.0.2 - FM07HD v1.2";
static FAKE_STR_INNER g_brand_inner;
static FAKE_STR g_brand;

static void *brand(void *str)
{
	BYTE *inner;
	if (!str || !(inner = *(BYTE **)((BYTE *)str + 8)))
		return str;
	if (*(WORD *)(inner + 4) != (sizeof BRAND_ORIGINAL / 2 - 1) || !*(WCHAR **)(inner + 8) ||
		memcmp(*(WCHAR **)(inner + 8), BRAND_ORIGINAL, sizeof BRAND_ORIGINAL - 2))
		return str;
	return &g_brand;
}

static short __fastcall hk_measure_string(void **font, void *edx, void *str, int all_advances)
{
	return orig_measure_string(font, edx, brand(str), all_advances);
}

static void __fastcall hk_draw_string(void **font, void *edx, BYTE *surf, int x, int y,
	DWORD *colour, DWORD *outline, void *str, void *hit_cb)
{
	BYTE *f = font ? (BYTE *)*font : NULL;
	str = brand(str);

	if (g_text_depth && surf == (BYTE *)&g_proxy && !hit_cb) {
		// shadow/outline/emboss styles recurse with +-1px offsets; scale them
		x = g_hx0 + (int)floor(((short)x - g_hx0) * g_zx + 0.5);
		y = g_hy0 + (int)floor(((short)y - g_hy0) * g_zy + 0.5);
	}
	if (g_text_depth || hit_cb || !g_on || !surf || (surf != g_win && *(DWORD *)surf != VT_IMAGE) || !f ||
		!f[FONT_LOADED]) {
		if (g_on && !g_text_depth && !hit_cb && surf && surf != g_win && surf != (BYTE *)&g_proxy) {
			DWORD chain[3];
			caller_chain((const DWORD *)_AddressOfReturnAddress(), chain);
			diag_add(g_diag_text, chain, *(DWORD *)surf, 1);
		}
		orig_draw_string(font, edx, surf, x, y, colour, outline, str, hit_cb);
		return;
	}
	if (surf != g_win) { // an off-screen IMAGE: record the text for a crisp replay at blit time
		record_image_text(font, edx, surf, (short)x, (short)y, colour, outline, str);
		return;
	}
	g_text_depth++;

	// 1. logical text into the game's buffer (kept consistent), without the blurry fallback
	g_suppress++;
	orig_draw_string(font, edx, surf, x, y, colour, outline, str, hit_cb);
	g_suppress--;

	// 2. the same text rasterised at physical size into the shadow buffer
	hires_text(font, *(DWORD *)(f + FONT_FLAGS), f[FONT_SIZE_X], f[FONT_SIZE_Y], surf, NULL, (short)x,
		(short)y, colour, outline, str);

	g_text_depth--;
}

// ---- fills -----------------------------------------------------------------------------------

// Clip a local rect against a surface's clip rect and convert it to physical shadow pixels.
static BOOL map_rect(BYTE *surf, const short *rect, int *x0, int *y0, int *x1, int *y1)
{
	const short *clip = (const short *)(surf + SURF_CLIP);
	int ox = *(short *)(surf + SURF_ORIGIN), oy = *(short *)(surf + SURF_ORIGIN + 2);
	int l = rect[0], t = rect[1], r = rect[0] + rect[2], b = rect[1] + rect[3];
	if (clip[2] == -1)
		return FALSE;
	if (l < clip[0]) l = clip[0];
	if (t < clip[1]) t = clip[1];
	if (r > clip[0] + clip[2]) r = clip[0] + clip[2];
	if (b > clip[1] + clip[3]) b = clip[1] + clip[3];
	if (l >= r || t >= b)
		return FALSE;
	*x0 = sx_(l + ox); *x1 = sx_(r + ox);
	*y0 = sy_(t + oy); *y1 = sy_(b + oy);
	if (*x0 < 0) *x0 = 0;
	if (*y0 < 0) *y0 = 0;
	if (*x1 > g_pw) *x1 = g_pw;
	if (*y1 > g_ph) *y1 = g_ph;
	return *x0 < *x1 && *y0 < *y1;
}

static void shadow_fill(int x0, int y0, int x1, int y1, DWORD colour, DWORD a);

static void __fastcall hk_fill_rect(BYTE *surf, void *edx, short *rect, DWORD colour, int alpha)
{
	int x0, y0, x1, y1;

	if (!g_on || surf != g_win) {
		orig_fill_rect(surf, edx, rect, colour, alpha);
		return;
	}
	g_suppress++;
	orig_fill_rect(surf, edx, rect, colour, alpha);
	g_suppress--;
	if (map_rect(surf, rect, &x0, &y0, &x1, &y1))
		shadow_fill(x0, y0, x1, y1, colour, alpha & 0xFF);
}

static void shadow_fill(int x0, int y0, int x1, int y1, DWORD colour, DWORD a)
{
	int x, y;
	DWORD ia, crb, cga;
	if (a == 0xFF) {
		for (y = y0; y < y1; y++) {
			DWORD *d = g_bits + (size_t)y * g_pw;
			for (x = x0; x < x1; x++)
				d[x] = colour;
		}
		return;
	}
	// same formula as the game's MMX fill (0x00EAC040): (d*(255-a) + c*a) >> 8 per byte
	ia = 255 - a;
	crb = (colour & 0xFF00FF) * a;
	cga = (colour >> 8 & 0xFF00FF) * a;
	for (y = y0; y < y1; y++) {
		DWORD *d = g_bits + (size_t)y * g_pw;
		for (x = x0; x < x1; x++) {
			DWORD p = d[x];
			DWORD rb = ((p & 0xFF00FF) * ia + crb) >> 8 & 0xFF00FF;
			DWORD ga = ((p >> 8 & 0xFF00FF) * ia + cga) >> 8 & 0xFF00FF;
			d[x] = rb | ga << 8;
		}
	}
}

// ---- window snapshots ----------------------------------------------------------------------
// Widgets such as TITLED_BOX (screen headers) copy a window area into a temporary IMAGE
// (IMAGE::copy_from), later blit that image back to the same place and draw on top. The copy is a
// read, but it uses the write lock, so the fallback would blur that area; and blitting the low-res
// copy back would put blurry pixels (including old text) under the new crisp text. We keep the
// hi-res pixels of the area with the image and restore those when the unchanged image is blitted
// back to the same place.

#define SNAP_SLOTS 8
typedef struct {
	BYTE *img;
	int ax, ay, w, h;   // logical, window absolute
	int px0, py0, pw, ph; // physical copy
	DWORD sum;          // checksum of the image's logical pixels after the copy
	DWORD *pixels;
} SNAPSHOT;
static SNAPSHOT g_snap[SNAP_SLOTS];
static int g_snap_next;

static DWORD image_sum(BYTE *img, int *w_out, int *h_out, const DWORD **base_out, int *pitch_out)
{
	void **vt = *(void ***)img;
	int w = ((vf_short_t)vt[0x14 / 4])(img, NULL), h = ((vf_short_t)vt[0x18 / 4])(img, NULL), x, y;
	short pt[4] = { 0, 0, 0, 0 }, pitch;
	const DWORD *base;
	DWORD sum = 2166136261u;
	*w_out = w;
	*h_out = h;
	if (w <= 0 || h <= 0)
		return 0;
	pt[0] = *(short *)(img + SURF_ORIGIN);
	pt[1] = *(short *)(img + SURF_ORIGIN + 2);
	pt[2] = (short)w;
	pt[3] = (short)h;
	base = ((vf_pixel_ptr_t)vt[0x2C / 4])(img, NULL, pt, &pitch);
	if (base_out)
		*base_out = base;
	if (pitch_out)
		*pitch_out = pitch;
	if (!base)
		return 0;
	for (y = 0; y < h; y++)
		for (x = 0; x < w; x++)
			sum = (sum ^ base[(size_t)y * pitch + x]) * 16777619u;
	return sum;
}

static void __fastcall hk_snapshot(BYTE *img, void *edx, BYTE *src, short *rect)
{
	SNAPSHOT *sn;
	int x0, y0, x1, y1, y, w, h;
	if (!g_on || src != g_win || !img || !rect) {
		orig_snapshot(img, edx, src, rect);
		return;
	}
	g_suppress++; // reading the window: nothing to upscale
	orig_snapshot(img, edx, src, rect);
	g_suppress--;

	sn = NULL;
	for (y = 0; y < SNAP_SLOTS; y++)
		if (g_snap[y].img == img)
			sn = &g_snap[y];
	if (!sn) {
		sn = &g_snap[g_snap_next];
		g_snap_next = (g_snap_next + 1) % SNAP_SLOTS;
	}
	free(sn->pixels);
	memset(sn, 0, sizeof *sn);
	sn->ax = rect[0] + *(short *)(src + SURF_ORIGIN);
	sn->ay = rect[1] + *(short *)(src + SURF_ORIGIN + 2);
	sn->w = rect[2];
	sn->h = rect[3];
	x0 = sx_(sn->ax); x1 = sx_(sn->ax + sn->w);
	y0 = sy_(sn->ay); y1 = sy_(sn->ay + sn->h);
	if (x0 < 0) x0 = 0;
	if (y0 < 0) y0 = 0;
	if (x1 > g_pw) x1 = g_pw;
	if (y1 > g_ph) y1 = g_ph;
	if (x1 <= x0 || y1 <= y0)
		return;
	sn->pixels = (DWORD *)malloc((size_t)(x1 - x0) * (y1 - y0) * 4);
	if (!sn->pixels)
		return;
	for (y = y0; y < y1; y++)
		memcpy(sn->pixels + (size_t)(y - y0) * (x1 - x0), g_bits + (size_t)y * g_pw + x0, (size_t)(x1 - x0) * 4);
	sn->px0 = x0; sn->py0 = y0; sn->pw = x1 - x0; sn->ph = y1 - y0;
	sn->sum = image_sum(img, &w, &h, NULL, NULL);
	if (w != sn->w || h != sn->h) { // not the simple resize+copy we expect
		free(sn->pixels);
		sn->pixels = NULL;
		return;
	}
	sn->img = img;
}

// If src is an unchanged snapshot being blitted back to where it was taken, restore our hi-res copy.
static BOOL restore_snapshot(BYTE *dst, int x, int y, BYTE *src)
{
	int i, w, h, ax, ay, py, x0, x1, y0, y1;
	SNAPSHOT *sn = NULL;
	for (i = 0; i < SNAP_SLOTS; i++)
		if (g_snap[i].img == src && g_snap[i].pixels)
			sn = &g_snap[i];
	if (!sn)
		return FALSE;
	ax = x + *(short *)(dst + SURF_ORIGIN);
	ay = y + *(short *)(dst + SURF_ORIGIN + 2);
	if (ax != sn->ax || ay != sn->ay || image_sum(src, &w, &h, NULL, NULL) != sn->sum || w != sn->w || h != sn->h)
		return FALSE;
	{
		short rect[4];
		rect[0] = (short)x; rect[1] = (short)y; rect[2] = (short)w; rect[3] = (short)h;
		if (!map_rect(dst, rect, &x0, &y0, &x1, &y1))
			return TRUE; // fully clipped: nothing to draw
	}
	if (x0 < sn->px0) x0 = sn->px0;
	if (y0 < sn->py0) y0 = sn->py0;
	if (x1 > sn->px0 + sn->pw) x1 = sn->px0 + sn->pw;
	if (y1 > sn->py0 + sn->ph) y1 = sn->py0 + sn->ph;
	for (py = y0; py < y1; py++)
		memcpy(g_bits + (size_t)py * g_pw + x0,
			sn->pixels + (size_t)(py - sn->py0) * sn->pw + (x0 - sn->px0), (size_t)(x1 - x0) * 4);
	return TRUE;
}

// ---- images ----------------------------------------------------------------------------------

// Bilinear blend of four pixels, two 8-bit channels per 32-bit lane (weights 0..256).
static __forceinline DWORD bilerp(DWORD a, DWORD b, DWORD c, DWORD d, DWORD wx, DWORD wy)
{
	DWORD ix = 256 - wx, iy = 256 - wy;
	DWORD rb0 = ((a & 0xFF00FF) * ix + (b & 0xFF00FF) * wx) >> 8 & 0xFF00FF;
	DWORD ga0 = ((a >> 8 & 0xFF00FF) * ix + (b >> 8 & 0xFF00FF) * wx) >> 8 & 0xFF00FF;
	DWORD rb1 = ((c & 0xFF00FF) * ix + (d & 0xFF00FF) * wx) >> 8 & 0xFF00FF;
	DWORD ga1 = ((c >> 8 & 0xFF00FF) * ix + (d >> 8 & 0xFF00FF) * wx) >> 8 & 0xFF00FF;
	return ((rb0 * iy + rb1 * wy) >> 8 & 0xFF00FF) | ((ga0 * iy + ga1 * wy) >> 8 & 0xFF00FF) << 8;
}

// Premultiply a straight-alpha pixel (alpha kept in the top byte).
static __forceinline DWORD premul(DWORD c)
{
	DWORD a = c >> 24;
	if (a == 255)
		return c;
	if (!a)
		return 0;
	return ((c & 0xFF00FF) * a >> 8 & 0xFF00FF) | ((c & 0xFF00) * a >> 8 & 0xFF00) | (c & 0xFF000000);
}

typedef struct {
	const DWORD *base;
	int pitch, sw, sh, ax, ay;
	BOOL premultiply; // alpha blits interpolate premultiplied colour (no dark fringes)
} SCALE_SRC;

static int g_col_i[8192], g_col_w[8192];

// Column tables for physical columns [px0, px1).
static void scale_cols(const SCALE_SRC *s, int px0, int px1)
{
	int px;
	for (px = px0; px < px1; px++) {
		double f = (px + 0.5) / g_zx - 0.5 - s->ax;
		int i = (int)floor(f), wt = (int)((f - i) * 256.0);
		if (i < 0) { i = 0; wt = 0; }
		if (i >= s->sw - 1) { i = s->sw - 1; wt = 0; }
		g_col_i[px - px0] = i;
		g_col_w[px - px0] = wt;
	}
}

// One physical row py of the scaled source over [px0, px1) (scale_cols(px0, px1) first).
static void scale_row(const SCALE_SRC *s, int py, int px0, int px1, DWORD *out)
{
	double f = (py + 0.5) / g_zy - 0.5 - s->ay;
	int j = (int)floor(f), wy = (int)((f - j) * 256.0), n = px1 - px0, k;
	const DWORD *r0, *r1;
	if (j < 0) { j = 0; wy = 0; }
	if (j >= s->sh - 1) { j = s->sh - 1; wy = 0; }
	r0 = s->base + (size_t)j * s->pitch;
	r1 = wy ? r0 + s->pitch : r0;
	for (k = 0; k < n; k++) {
		int i = g_col_i[k], wx = g_col_w[k];
		DWORD a = r0[i], b = wx ? r0[i + 1] : a, c = r1[i], d = wx ? r1[i + 1] : c;
		if (s->premultiply && ((a & b & c & d) >> 24) != 255) {
			if (!((a | b | c | d) >> 24)) {
				out[k] = 0;
				continue;
			}
			a = premul(a); b = premul(b); c = premul(c); d = premul(d);
		}
		out[k] = bilerp(a, b, c, d, wx, wy);
	}
}

// Write n scaled pixels onto the shadow buffer: copy, or premultiplied "over" with galpha.
static void composite_row(DWORD *dst, const DWORD *src, int n, BOOL blend, DWORD galpha)
{
	int k;
	if (!blend) {
		for (k = 0; k < n; k++)
			dst[k] = src[k] | 0xFF000000;
		return;
	}
	for (k = 0; k < n; k++) {
		DWORD s = src[k], a, inv, p, da;
		if (galpha != 255)
			s = ((s & 0xFF00FF) * galpha >> 8 & 0xFF00FF) | ((s >> 8 & 0xFF00FF) * galpha >> 8 & 0xFF00FF) << 8;
		a = s >> 24;
		if (a == 255) {
			dst[k] = s;
			continue;
		}
		if (!a)
			continue;
		inv = 255 - a;
		inv += inv >> 7; // 0..256
		p = dst[k];
		da = p >> 24;
		p = (((p & 0xFF00FF) * inv >> 8 & 0xFF00FF) + (s & 0xFF00FF)) |
			(((p >> 8 & 0xFF00FF) * inv >> 8 & 0xFF00FF) + (s >> 8 & 0xFF00FF)) << 8;
		dst[k] = (p & 0x00FFFFFF) | (da > a ? da : a) << 24;
	}
}

// Images are scaled directly on every draw, split across the worker pool. (A cache of scaled
// images was tried: verifying it - a full checksum per draw, since sampled checks can miss small
// changes such as commentary text - cost more than rescaling, and stale entries showed old content.)
typedef struct {
	const SCALE_SRC *s;
	int x0, x1;
	BOOL blend;
	DWORD galpha;
} IMAGE_JOB;

static void image_rows_direct(void *ctx, int y0, int y1)
{
	const IMAGE_JOB *j = (const IMAGE_JOB *)ctx;
	DWORD row[8192]; // per thread
	int py;
	for (py = y0; py < y1; py++) {
		scale_row(j->s, py, j->x0, j->x1, row);
		composite_row(g_bits + (size_t)py * g_pw + j->x0, row, j->x1 - j->x0, j->blend, j->galpha);
	}
}

// Redraw src (an IMAGE_BASE) at logical local (x,y) of the window into the shadow buffer,
// sampled bilinearly at physical resolution. blend: per-pixel alpha "over" like the game's MMX
// blit (0x00EABC40), interpolating premultiplied colour so edges get no dark fringes.
static void shadow_image(BYTE *dst, int x, int y, BYTE *src, DWORD galpha, BOOL blend)
{
	void **vt = *(void ***)src;
	int sw = ((vf_short_t)vt[0x14 / 4])(src, NULL), sh = ((vf_short_t)vt[0x18 / 4])(src, NULL);
	short rect[4], pt[4], pitch;
	int x0, y0, x1, y1;
	SCALE_SRC s;
	IMAGE_JOB j;
	IMGTEXT *it = NULL;

	if (sw <= 0 || sh <= 0)
		return;
	rect[0] = (short)x; rect[1] = (short)y; rect[2] = (short)sw; rect[3] = (short)sh;
	if (!map_rect(dst, rect, &x0, &y0, &x1, &y1))
		return;

	if (blend && ((vf_char_t)vt[0x20 / 4])(src, NULL)) {
		// solid image: the game fills with its colour (alpha modulated unless galpha == 0xff)
		DWORD c;
		((vf_get_colour_t)vt[0x24 / 4])(src, NULL, &c);
		shadow_fill(x0, y0, x1, y1, c, galpha == 0xFF ? 0xFF : (c >> 24) * galpha >> 8);
		return;
	}

	pt[0] = *(short *)(src + SURF_ORIGIN);
	pt[1] = *(short *)(src + SURF_ORIGIN + 2);
	pt[2] = (short)sw;
	pt[3] = (short)sh;
	s.base = ((vf_pixel_ptr_t)vt[0x2C / 4])(src, NULL, pt, &pitch);
	if (!s.base || x1 - x0 > 8192)
		return;
	// scale the text-free copy, then draw its text (opaque blits only: a fading blit keeps the
	// image's own text, as the replay below is opaque)
	if ((it = imgtext_for_blit(src, galpha)) != NULL) {
		s.base = it->background;
		pitch = (short)it->w;
	}
	s.pitch = pitch;
	s.sw = sw;
	s.sh = sh;
	s.ax = x + *(short *)(dst + SURF_ORIGIN);
	s.ay = y + *(short *)(dst + SURF_ORIGIN + 2);
	s.premultiply = blend;

	scale_cols(&s, x0, x1);
	j.s = &s; j.x0 = x0; j.x1 = x1; j.blend = blend; j.galpha = galpha;
	parallel_rows(y0, y1, x1 - x0, image_rows_direct, &j);
	if (it && galpha == 0xFF)
		imgtext_replay(it, dst, x, y);
}

static void __fastcall hk_blit_alpha(BYTE *dst, void *edx, int x, int y, BYTE *src, int alpha)
{
	if (!g_on || dst != g_win || !src) {
		orig_blit_alpha(dst, edx, x, y, src, alpha);
		return;
	}
	g_suppress++;
	orig_blit_alpha(dst, edx, x, y, src, alpha);
	g_suppress--;
	if ((alpha & 0xFF) == 0xFF && restore_snapshot(dst, (short)x, (short)y, src))
		return;
	shadow_image(dst, (short)x, (short)y, src, alpha & 0xFF, TRUE);
}

static void __fastcall hk_blit_copy(BYTE *dst, void *edx, int x, int y, BYTE *src)
{
	if (!g_on || dst != g_win || !src) {
		orig_blit_copy(dst, edx, x, y, src);
		return;
	}
	g_suppress++;
	orig_blit_copy(dst, edx, x, y, src);
	g_suppress--;
	if (restore_snapshot(dst, (short)x, (short)y, src))
		return;
	shadow_image(dst, (short)x, (short)y, src, 0xFF, FALSE);
}

// ---- tiled fills -----------------------------------------------------------------------------

// IMAGE_BASE::tile fills a rect by repeating a texture from the rect's top-left (box and panel
// backgrounds). Replayed natively: bilinear with wrap-around, copy (mode 0) or alpha over (mode 1).
// Solid textures make the game call fill_rect, which is already replayed.
static int g_tcol_i0[8192], g_tcol_i1[8192], g_tcol_w[8192];

typedef struct {
	const DWORD *base;
	int pitch, sw, sh, ay, x0, x1;
	BOOL blend;
} TILE_JOB;

static int wrap(int v, int n)
{
	v %= n;
	return v < 0 ? v + n : v;
}

static void tile_rows(void *ctx, int y0, int y1)
{
	const TILE_JOB *j = (const TILE_JOB *)ctx;
	DWORD row[8192];
	int py, k, n = j->x1 - j->x0;
	for (py = y0; py < y1; py++) {
		double f = (py + 0.5) / g_zy - 0.5 - j->ay;
		int jj = (int)floor(f), wy = (int)((f - jj) * 256.0);
		const DWORD *r0 = j->base + (size_t)wrap(jj, j->sh) * j->pitch;
		const DWORD *r1 = j->base + (size_t)wrap(jj + 1, j->sh) * j->pitch;
		for (k = 0; k < n; k++) {
			DWORD a = r0[g_tcol_i0[k]], b = r0[g_tcol_i1[k]], c = r1[g_tcol_i0[k]], d = r1[g_tcol_i1[k]];
			if (j->blend && ((a & b & c & d) >> 24) != 255) {
				if (!((a | b | c | d) >> 24)) {
					row[k] = 0;
					continue;
				}
				a = premul(a); b = premul(b); c = premul(c); d = premul(d);
			}
			row[k] = bilerp(a, b, c, d, g_tcol_w[k], wy);
		}
		composite_row(g_bits + (size_t)py * g_pw + j->x0, row, n, j->blend, 255);
	}
}

static void __fastcall hk_tile_image(BYTE *dst, void *edx, short *rect, BYTE *src, int mode)
{
	void **vt;
	short pt[4], pitch;
	int x0, y0, x1, y1, px, sw, sh, ax;
	TILE_JOB j;

	if (!g_on || dst != g_win || !src || !rect || (mode != 0 && mode != 1)) {
		orig_tile_image(dst, edx, rect, src, mode);
		return;
	}
	g_suppress++;
	orig_tile_image(dst, edx, rect, src, mode);
	g_suppress--;

	vt = *(void ***)src;
	sw = ((vf_short_t)vt[0x14 / 4])(src, NULL);
	sh = ((vf_short_t)vt[0x18 / 4])(src, NULL);
	if (sw <= 0 || sh <= 0 || ((vf_char_t)vt[0x20 / 4])(src, NULL)) // solid: fill_rect replayed it
		return;
	if (!map_rect(dst, rect, &x0, &y0, &x1, &y1) || x1 - x0 > 8192)
		return;
	pt[0] = *(short *)(src + SURF_ORIGIN);
	pt[1] = *(short *)(src + SURF_ORIGIN + 2);
	pt[2] = (short)sw;
	pt[3] = (short)sh;
	j.base = ((vf_pixel_ptr_t)vt[0x2C / 4])(src, NULL, pt, &pitch);
	if (!j.base)
		return;
	j.pitch = pitch;
	j.sw = sw;
	j.sh = sh;
	ax = rect[0] + *(short *)(dst + SURF_ORIGIN);
	j.ay = rect[1] + *(short *)(dst + SURF_ORIGIN + 2);
	j.x0 = x0;
	j.x1 = x1;
	j.blend = mode == 1;
	for (px = x0; px < x1; px++) {
		double f = (px + 0.5) / g_zx - 0.5 - ax;
		int i = (int)floor(f);
		g_tcol_i0[px - x0] = wrap(i, sw);
		g_tcol_i1[px - x0] = wrap(i + 1, sw);
		g_tcol_w[px - x0] = (int)((f - i) * 256.0);
	}
	parallel_rows(y0, y1, x1 - x0, tile_rows, &j);
}

// ---- lines -----------------------------------------------------------------------------------

// The engine's Bresenham line (pitch markings, tactic arrows) locks the WHOLE surface for every
// line, so the generic fallback would upscale the entire window per line - slow, and it overwrites
// natively drawn hi-res text with blurry copies. Upscale just the line's bounding box instead.
static void __fastcall hk_draw_line(BYTE *surf, void *edx, short *p0, short *p1, int a3, int a4,
	int a5, int a6)
{
	int ox, oy, x0, y0, x1, y1;
	if (!g_on || surf != g_win || !p0 || !p1) {
		orig_draw_line(surf, edx, p0, p1, a3, a4, a5, a6);
		return;
	}
	g_suppress++;
	orig_draw_line(surf, edx, p0, p1, a3, a4, a5, a6);
	g_suppress--;
	ox = *(short *)(surf + SURF_ORIGIN);
	oy = *(short *)(surf + SURF_ORIGIN + 2);
	x0 = (p0[0] < p1[0] ? p0[0] : p1[0]) + ox - 1;
	x1 = (p0[0] > p1[0] ? p0[0] : p1[0]) + ox + 2;
	y0 = (p0[1] < p1[1] ? p0[1] : p1[1]) + oy - 1;
	y1 = (p0[1] > p1[1] ? p0[1] : p1[1]) + oy + 2;
	upscale(x0, y0, x1 - x0, y1 - y0);
}

// ---- present ---------------------------------------------------------------------------------

void hires_present(HDC hdc, BYTE *win, BOOL full)
{
	if (full) {
		BitBlt(hdc, 0, 0, g_pw, g_ph, g_hdc, 0, 0, SRCCOPY);
	}
	else {
		int x0 = sx_(*(short *)(win + WIN_DIRTY_X0)) - 1, x1 = sx_(*(short *)(win + WIN_DIRTY_X1) + 1) + 1;
		int y0 = sy_(*(short *)(win + WIN_DIRTY_Y0)) - 1, y1 = sy_(*(short *)(win + WIN_DIRTY_Y1) + 1) + 1;
		if (x0 < 0) x0 = 0;
		if (y0 < 0) y0 = 0;
		BitBlt(hdc, x0, y0, x1 - x0, y1 - y0, g_hdc, x0, y0, SRCCOPY);
	}
}

// ---- install ---------------------------------------------------------------------------------

static BOOL patch_vtable_slot(DWORD vt, int slot, DWORD expect, void *fn)
{
	DWORD *p = (DWORD *)(vt + slot), old;
	if (*p != expect)
		return FALSE;
	if (!VirtualProtect(p, 4, PAGE_READWRITE, &old))
		return FALSE;
	*p = (DWORD)fn;
	VirtualProtect(p, 4, old, &old);
	return TRUE;
}

BOOL hires_install(void (*log)(const char *fmt, ...), BOOL smooth, BOOL enable)
{
	int i;
	logf_ = log;
	g_smooth = smooth;
	g_brand_inner.len = (WORD)(sizeof g_brand_chars / 2 - 1);
	g_brand_inner.chars = g_brand_chars;
	g_brand.inner = &g_brand_inner;
	if (!hook_verify(ADDR_DRAW_STRING, SIG_DRAW_STRING, sizeof SIG_DRAW_STRING) ||
		!hook_verify(ADDR_SET_FONT_SIZE, SIG_SET_FONT_SIZE, sizeof SIG_SET_FONT_SIZE) ||
		!hook_verify(ADDR_MEASURE_STRING, SIG_MEASURE_STRING, sizeof SIG_MEASURE_STRING) ||
		!hook_verify(ADDR_T2K_SET_TRANSFORM, SIG_T2K_SET_TRANSFORM, sizeof SIG_T2K_SET_TRANSFORM) ||
		!hook_verify(ADDR_FILL_RECT, SIG_FILL_RECT, sizeof SIG_FILL_RECT) ||
		!hook_verify(ADDR_BLIT_ALPHA, SIG_BLIT_ALPHA, sizeof SIG_BLIT_ALPHA) ||
		!hook_verify(ADDR_BLIT_COPY, SIG_BLIT_COPY, sizeof SIG_BLIT_COPY) ||
		!hook_verify(ADDR_DRAW_LINE, SIG_DRAW_LINE, sizeof SIG_DRAW_LINE) ||
		!hook_verify(ADDR_TILE_IMAGE, SIG_TILE_IMAGE, sizeof SIG_TILE_IMAGE) ||
		!hook_verify(ADDR_SNAPSHOT, SIG_SNAPSHOT, sizeof SIG_SNAPSHOT) ||
		*(DWORD *)(VT_WINDOW_PLATFORM + VT_SLOT_LOCK_RECT) != ADDR_WIN_LOCK_RECT ||
		*(DWORD *)(VT_WINDOW_PLATFORM + VT_SLOT_UNLOCK) != ADDR_SHARED_RET) {
		log("hires: signature mismatch; hi-res rendering disabled");
		return FALSE;
	}

	for (i = 0; i < 64; i++)
		g_proxy_vt[i] = (void *)px_unexpected;
	g_proxy_vt[0x14 / 4] = (void *)px_width;
	g_proxy_vt[0x18 / 4] = (void *)px_height;
	g_proxy_vt[0x2C / 4] = (void *)px_lock;
	g_proxy_vt[0x30 / 4] = (void *)px_lock;
	g_proxy_vt[0x34 / 4] = (void *)px_unlock;
	g_proxy.vt = g_proxy_vt;
	g_proxy.vt2 = g_proxy_vt;

	if (!hook_install(ADDR_DRAW_STRING, (void *)hk_draw_string, 6, (void **)&orig_draw_string) ||
		!hook_install(ADDR_MEASURE_STRING, (void *)hk_measure_string, 5, (void **)&orig_measure_string) ||
		!hook_install(ADDR_T2K_SET_TRANSFORM, (void *)hk_t2k_set_transform, 6,
			(void **)&orig_t2k_set_transform) ||
		!hook_install(ADDR_FILL_RECT, (void *)hk_fill_rect, 7, (void **)&orig_fill_rect) ||
		!hook_install(ADDR_BLIT_ALPHA, (void *)hk_blit_alpha, 5, (void **)&orig_blit_alpha) ||
		!hook_install(ADDR_BLIT_COPY, (void *)hk_blit_copy, 5, (void **)&orig_blit_copy) ||
		!hook_install(ADDR_DRAW_LINE, (void *)hk_draw_line, 7, (void **)&orig_draw_line) ||
		!hook_install(ADDR_TILE_IMAGE, (void *)hk_tile_image, 8, (void **)&orig_tile_image) ||
		!hook_install(ADDR_SNAPSHOT, (void *)hk_snapshot, 7, (void **)&orig_snapshot) ||
		!patch_vtable_slot(VT_WINDOW_PLATFORM, VT_SLOT_LOCK_RECT, ADDR_WIN_LOCK_RECT, (void *)hk_win_lock_rect) ||
		!patch_vtable_slot(VT_WINDOW_PLATFORM, VT_SLOT_UNLOCK, ADDR_SHARED_RET, (void *)hk_win_unlock)) {
		log("hires: install failed");
		return FALSE;
	}
	g_installed = enable; // hooks always on (branding); the shadow buffer only if enabled
	log("hires: installed (text, fills, images native; rest upscaled %s)", smooth ? "bilinear" : "nearest");
	return TRUE;
}

// ---- debug capture ---------------------------------------------------------------------------

static BOOL write_bmp(const WCHAR *path, const DWORD *bits, int w, int h, int pitch)
{
	BITMAPFILEHEADER fh;
	BITMAPINFOHEADER ih;
	DWORD n;
	int y;
	HANDLE f = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
	if (f == INVALID_HANDLE_VALUE)
		return FALSE;
	memset(&fh, 0, sizeof fh);
	memset(&ih, 0, sizeof ih);
	fh.bfType = 0x4D42;
	fh.bfOffBits = sizeof fh + sizeof ih;
	fh.bfSize = fh.bfOffBits + (DWORD)w * h * 4;
	ih.biSize = sizeof ih;
	ih.biWidth = w;
	ih.biHeight = -h;
	ih.biPlanes = 1;
	ih.biBitCount = 32;
	WriteFile(f, &fh, sizeof fh, &n, NULL);
	WriteFile(f, &ih, sizeof ih, &n, NULL);
	for (y = 0; y < h; y++)
		WriteFile(f, bits + (size_t)y * pitch, (DWORD)w * 4, &n, NULL);
	CloseHandle(f);
	return TRUE;
}

BOOL hires_dump(const WCHAR *path, BYTE *win)
{
	diag_dump("fallback upscales since last capture", g_diag_fallback);
	diag_dump("text drawn off-window since last capture", g_diag_text);
	logf_("diag image text: %lu recorded; blits: %lu replayed, %lu no record, %lu changed after text, "
		"%lu too many strings, %lu semi-transparent", g_it_recorded, g_it_used, g_it_no_record, g_it_changed,
		g_it_overflow, g_it_alpha);
	g_it_recorded = g_it_used = g_it_no_record = g_it_changed = g_it_overflow = g_it_alpha = g_it_other = 0;
	if (g_on) {
		// also the game's own logical frame, to tell replay bugs from game behaviour
		WCHAR logical[MAX_PATH];
		lstrcpynW(logical, path, MAX_PATH - 12);
		lstrcatW(logical, L".logical.bmp");
		if (win && *(DWORD **)(win + WIN_BITS))
			write_bmp(logical, *(DWORD **)(win + WIN_BITS), *(short *)(win + WIN_BB_W),
				*(short *)(win + WIN_BB_H), *(short *)(win + WIN_PITCH));
		return write_bmp(path, g_bits, g_pw, g_ph, g_pw);
	}
	if (!win || !*(DWORD **)(win + WIN_BITS))
		return FALSE;
	return write_bmp(path, *(DWORD **)(win + WIN_BITS), *(short *)(win + WIN_BB_W),
		*(short *)(win + WIN_BB_H), *(short *)(win + WIN_PITCH));
}
